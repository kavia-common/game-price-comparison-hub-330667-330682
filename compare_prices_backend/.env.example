# ============================================================================
# PriceHunt Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed.

# --- Server ---
HOST=0.0.0.0
PORT=3001
UVICORN_HOST=0.0.0.0
UVICORN_WORKERS=1
NODE_ENV=development

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=3600

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Request ---
REQUEST_TIMEOUT_MS=30000

# --- Firecrawl (for real scraping) ---
# FIRECRAWL_API_KEY=your_api_key_here
# FIRECRAWL_ENABLED=true

# --- Debugging ---
DEBUG_SCRAPER_ERRORS=true
USE_MOCK_FALLBACK=true

# --- Ollama LLM Service ---
# OLLAMA_BASE_URL: URL where the ollama-service is reachable.
#   The ollama-service container exposes its HTTP API on port 11434.
#   When running on the same host: http://localhost:11434
#   When running in separate containers: use the container hostname/IP
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL: The LLM model to use for HTML extraction
OLLAMA_MODEL=llama3.2
# OLLAMA_ENABLED: Set to true to enable LLM-based extraction fallback
OLLAMA_ENABLED=true
# OLLAMA_TIMEOUT: Timeout in seconds for Ollama API requests
OLLAMA_TIMEOUT=60
