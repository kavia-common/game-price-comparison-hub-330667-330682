# FastAPI app settings (example)
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
VITE_LOG_LEVEL=info

# Enable debug surfacing of Playwright/store scraping errors in API responses.
# When true, each store that fails to return HTML or finds no products will add
# a synthetic [DEBUG: ...] entry to the /compare-prices results so failures are
# visible without inspecting server logs.
DEBUG_SCRAPER_ERRORS=false

# When true AND all Playwright scrapers return zero priced results (e.g. in a
# sandboxed development environment without internet access), the API will serve
# mock catalog data so the frontend remains functional.
USE_MOCK_FALLBACK=false

# (Optional) Firecrawl settings for future cloud scraping integration
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false

# Ollama LLM service settings for intelligent HTML extraction
# The Ollama service (ollama-service container) provides LLM-based extraction
# as a fallback when CSS-selector-based scraping yields zero results (selector drift).
#
# OLLAMA_BASE_URL: Base URL of the Ollama REST API.
#   When ollama-service runs on the same host: http://localhost:11434
#   When running in separate containers: use the container hostname/IP
# OLLAMA_MODEL: Model name to use for extraction (must be pulled in ollama-service)
# OLLAMA_ENABLED: Master switch — "true" to enable LLM extraction fallback
# OLLAMA_TIMEOUT: Request timeout in seconds for Ollama API calls
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=60
